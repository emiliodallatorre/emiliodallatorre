---
import githubFallback from '../data/github-profile.fallback.json';

export interface Props {
  username: string;
}

const { username } = Astro.props;

type GithubProfile = {
  name: string | null;
  login: string;
  bio: string | null;
  avatar_url: string;
  html_url: string;
  public_repos: number;
  followers: number;
  created_at: string;
};

let profile: GithubProfile | null = null;

try {
  const response = await fetch(`https://api.github.com/users/${username}`, {
    headers: {
      Accept: 'application/vnd.github+json',
      'User-Agent': 'emiliodallatorre.it-astro-build',
    },
  });
  if (response.ok) {
    profile = await response.json();
  } else {
    console.warn(
      `GithubCard: GitHub API responded ${response.status} for "${username}", using bundled fallback`,
    );
  }
} catch (error) {
  console.warn(
    `GithubCard: failed to fetch GitHub profile for "${username}", using bundled fallback`,
    error,
  );
}

if (!profile && githubFallback.login === username) {
  profile = githubFallback;
}

const memberSince = profile ? new Date(profile.created_at).getFullYear() : null;
---

{
  profile && (
    <a class="github-card" href={profile.html_url} target="_blank" rel="noopener">
      <img
        class="github-card-avatar"
        src={`${profile.avatar_url}&s=160`}
        width="72"
        height="72"
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
      <div class="github-card-body">
        <p class="github-card-name">{profile.name || profile.login}</p>
        {profile.bio && <p class="github-card-bio">{profile.bio}</p>}
        <dl class="github-card-stats">
          <div>
            <dd>{profile.public_repos}</dd>
            <dt>Repositories</dt>
          </div>
          <div>
            <dd>{profile.followers}</dd>
            <dt>Followers</dt>
          </div>
          {memberSince && (
            <div>
              <dd>{memberSince}</dd>
              <dt>On GitHub since</dt>
            </div>
          )}
        </dl>
      </div>
      <span class="github-card-cta" aria-hidden="true">
        →
      </span>
    </a>
  )
}
